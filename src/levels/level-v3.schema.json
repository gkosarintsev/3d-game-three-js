{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Level brief v3 (kind: cityforge)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this brief schema: ./level-v3.schema.json."
    },
    "kind": {
      "type": "string",
      "enum": [
        "cityforge"
      ],
      "description": "CityForge source brief; entities are compiled into the level module."
    },
    "metadata": {
      "$ref": "./level-common.schema.json#/definitions/metadata"
    },
    "ground": {
      "$ref": "./level-common.schema.json#/definitions/ground"
    },
    "gameplay": {
      "$ref": "./level-common.schema.json#/definitions/gameplay"
    },
    "stream": {
      "$ref": "./level-common.schema.json#/definitions/stream"
    },
    "cityforge": {
      "$ref": "./level-common.schema.json#/definitions/cityforge"
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "уникальный id дома"
          },
          "name": {
            "type": "string",
            "description": "название для метки debugIds"
          },
          "archetype": {
            "type": "string",
            "enum": [
              "box",
              "slab",
              "l",
              "u",
              "t",
              "cross",
              "bar_pair",
              "stepped2",
              "stepped3",
              "podium_tower"
            ],
            "description": "форма корпуса (служебное, генератор)"
          },
          "buildingType": {
            "type": "string",
            "description": "тип дома"
          },
          "district": {
            "type": "string",
            "description": "id района (служебное, генератор)"
          },
          "isEnterable": {
            "type": "boolean",
            "description": "false — только фасадный декор",
            "default": true
          },
          "floorsCount": {
            "type": "number",
            "minimum": 1,
            "maximum": 60,
            "description": "эт: число этажей"
          },
          "floorHeight": {
            "type": "number",
            "minimum": 2.4,
            "maximum": 8,
            "description": "м: высота этажа"
          },
          "baseY": {
            "type": "number",
            "description": "м: пол первого этажа"
          },
          "foundation": {
            "type": "string",
            "enum": [
              "podium",
              "terrain"
            ],
            "description": "вариант фундамента"
          },
          "facadeMaterial": {
            "type": "string",
            "description": "материал фасада",
            "default": "concrete"
          },
          "wallColor": {
            "type": "string",
            "description": "hex-цвет фасада"
          },
          "houseKind": {
            "type": "string",
            "description": "вид/архетип дома"
          },
          "houseStyleId": {
            "type": "string",
            "description": "стиль дома"
          },
          "entrances": {
            "type": "number",
            "minimum": 1,
            "maximum": 8,
            "description": "число подъездов/секций"
          },
          "detailedVisual": {
            "type": "string",
            "description": "детальная визуальная модель"
          },
          "windowDensity": {
            "type": "number",
            "minimum": 1,
            "maximum": 3,
            "description": "плотность окон"
          },
          "windowScale": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2,
            "description": "масштаб окон"
          },
          "attachment": {
            "type": "object",
            "properties": {
              "hostId": {
                "type": "string",
                "description": "id здания-хоста"
              },
              "offset": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "м: плановый сдвиг по X (IR-метаданные)"
                  },
                  "z": {
                    "type": "number",
                    "description": "м: плановый сдвиг по Z (IR-метаданные)"
                  }
                },
                "additionalProperties": false,
                "description": "опциональный плановый сдвиг относительно хоста"
              }
            },
            "required": [
              "hostId"
            ],
            "additionalProperties": false,
            "description": "пристройка/самострой: отдельное здание, привязанное к hostId (ADR-005)"
          },
          "facadeBlankSides": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "enum": [
                "north",
                "south",
                "east",
                "west"
              ],
              "description": "сторона локального фасада без окон"
            },
            "description": "список глухих фасадов без оконных квадов (ADR-005)"
          },
          "roofMaterial": {
            "type": "string",
            "description": "материал кровли"
          },
          "roofColor": {
            "type": "string",
            "description": "цвет кровли"
          },
          "trimFinish": {
            "type": "string",
            "description": "отделка"
          },
          "houseFeatures": {
            "type": "object",
            "properties": {},
            "additionalProperties": false,
            "description": "фичи дома"
          },
          "roof": {
            "type": "object",
            "properties": {
              "walkable": {
                "type": "boolean",
                "description": "ходовая ли кровля",
                "default": false
              },
              "parapet": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.5,
                "description": "м: парапет",
                "default": 0.9
              }
            },
            "additionalProperties": false,
            "description": "кровля"
          },
          "footprint": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "description": "м: мировая координата X"
                },
                "z": {
                  "type": "number",
                  "description": "м: мировая координата Z"
                }
              },
              "required": [
                "x",
                "z"
              ],
              "additionalProperties": false,
              "description": "точка в плане (метры)"
            },
            "description": "м: полигон плана дома"
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "id комнаты"
                },
                "floor": {
                  "type": "number",
                  "minimum": 0,
                  "description": "этаж"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "office",
                    "corridor",
                    "hall",
                    "room",
                    "cafe",
                    "utility",
                    "lobby",
                    "market",
                    "warehouse"
                  ],
                  "description": "назначение"
                },
                "polygon": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "description": "м: мировая координата X"
                      },
                      "z": {
                        "type": "number",
                        "description": "м: мировая координата Z"
                      }
                    },
                    "required": [
                      "x",
                      "z"
                    ],
                    "additionalProperties": false,
                    "description": "точка в плане (метры)"
                  },
                  "description": "м: план комнаты"
                },
                "connections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "target": {
                        "type": "string",
                        "description": "id цели за проёмом"
                      },
                      "portalPosition": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number",
                            "description": "м: мировая координата X"
                          },
                          "y": {
                            "type": "number",
                            "description": "м: мировая отметка"
                          },
                          "z": {
                            "type": "number",
                            "description": "м: мировая координата Z"
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "additionalProperties": false,
                        "description": "точка в мире (метры)"
                      },
                      "linkType": {
                        "type": "string",
                        "enum": [
                          "main_entrance",
                          "door",
                          "back_entrance"
                        ],
                        "description": "тип связки"
                      }
                    },
                    "required": [
                      "target"
                    ],
                    "additionalProperties": false,
                    "description": "дверь/проём"
                  },
                  "description": "двери комнаты"
                }
              },
              "required": [
                "id",
                "floor",
                "type",
                "polygon"
              ],
              "additionalProperties": false,
              "description": "комната"
            },
            "description": "комнаты дома"
          },
          "stairs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "id марша"
                },
                "connectsFloors": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "description": "[с, по]"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "straight",
                    "l_shape",
                    "spiral",
                    "ladder"
                  ],
                  "description": "тип марша"
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "description": "м: мировая координата X"
                    },
                    "z": {
                      "type": "number",
                      "description": "м: мировая координата Z"
                    }
                  },
                  "required": [
                    "x",
                    "z"
                  ],
                  "additionalProperties": false,
                  "description": "точка в плане (метры)"
                },
                "rotation": {
                  "type": "number",
                  "description": "град",
                  "default": 0
                },
                "dimensions": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "number",
                      "minimum": 1,
                      "description": "м"
                    },
                    "length": {
                      "type": "number",
                      "minimum": 1,
                      "description": "м"
                    },
                    "height": {
                      "type": "number",
                      "description": "м"
                    }
                  },
                  "required": [
                    "width",
                    "length"
                  ],
                  "additionalProperties": false,
                  "description": "габарит марша"
                }
              },
              "required": [
                "id",
                "connectsFloors",
                "type"
              ],
              "additionalProperties": false,
              "description": "марш"
            },
            "description": "марши дома"
          },
          "rotation": {
            "type": "number",
            "minimum": -360,
            "maximum": 360,
            "description": "град: поворот дома вокруг центра габарита footprint",
            "default": 0
          },
          "districtFrame": {
            "type": "object",
            "properties": {
              "cx": {
                "type": "number",
                "description": "м"
              },
              "cz": {
                "type": "number",
                "description": "м"
              },
              "yaw": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "description": "град"
              }
            },
            "required": [
              "cx",
              "cz",
              "yaw"
            ],
            "additionalProperties": false,
            "description": "кадр косого района (служебное, генератор)"
          }
        },
        "required": [
          "id",
          "floorsCount",
          "floorHeight",
          "footprint",
          "rooms"
        ],
        "additionalProperties": false,
        "description": "дом"
      },
      "description": "дома"
    }
  },
  "required": [
    "kind",
    "metadata",
    "ground",
    "gameplay",
    "cityforge"
  ],
  "additionalProperties": false,
  "description": "CityForge source level from docs/world-format.md."
}
