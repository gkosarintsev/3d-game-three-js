                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "description": "м: мировая координата X"
                    },
                    "z": {
                      "type": "number",
                      "description": "м: мировая координата Z"
                    }
                  },
                  "required": [
                    "x",
                    "z"
                  ],
                  "additionalProperties": false,
                  "description": "точка в плане (метры)"
                },
                "rotation": {
                  "type": "number",
                  "description": "град",
                  "default": 0
                },
                "dimensions": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "number",
                      "minimum": 1,
                      "description": "м"
                    },
                    "length": {
                      "type": "number",
                      "minimum": 1,
                      "description": "м"
                    },
                    "height": {
                      "type": "number",
                      "description": "м"
                    }
                  },
                  "required": [
                    "width",
                    "length"
                  ],
                  "additionalProperties": false,
                  "description": "габарит марша"
                }
              },
              "required": [
                "id",
                "connectsFloors",
                "type"
              ],
              "additionalProperties": false,
              "description": "марш"
            },
            "description": "марши дома"
          },
          "rotation": {
            "type": "number",
            "minimum": -360,
            "maximum": 360,
            "description": "град: поворот дома вокруг центра габарита footprint",
            "default": 0
          },
          "districtFrame": {
            "type": "object",
            "properties": {
              "cx": {
                "type": "number",
                "description": "м"
              },
              "cz": {
                "type": "number",
                "description": "м"
              },
              "yaw": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
