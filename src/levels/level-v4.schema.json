              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "id марша"
                },
                "connectsFloors": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "description": "[с, по]"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "straight",
                    "l_shape",
                    "spiral",
                    "ladder"
