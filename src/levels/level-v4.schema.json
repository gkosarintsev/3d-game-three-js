                      }
                    },
                    "required": [
                      "target"
                    ],
                    "additionalProperties": false,
                    "description": "дверь/проём"
                  },
                  "description": "двери комнаты"
                }
              },
              "required": [
                "id",
                "floor",
                "type",
                "polygon"
              ],
              "additionalProperties": false,
              "description": "комната"
            },
            "description": "комнаты дома"
          },
          "stairs": {
            "type": "array",
