                  "description": "назначение"
                },
                "polygon": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "description": "м: мировая координата X"
                      },
                      "z": {
                        "type": "number",
                        "description": "м: мировая координата Z"
                      }
                    },
                    "required": [
                      "x",
                      "z"
                    ],
                    "additionalProperties": false,
                    "description": "точка в плане (метры)"
                  },
                  "description": "м: план комнаты"
                },
                "connections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "target": {
                        "type": "string",
                        "description": "id цели за проёмом"
                      },
                      "portalPosition": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number",
                            "description": "м: мировая координата X"
                          },
                          "y": {
                            "type": "number",
                            "description": "м: мировая отметка"
                          },
                          "z": {
                            "type": "number",
                            "description": "м: мировая координата Z"
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "additionalProperties": false,
                        "description": "точка в мире (метры)"
                      },
                      "linkType": {
                        "type": "string",
                        "enum": [
                          "main_entrance",
                          "door",
                          "back_entrance"
                        ],
