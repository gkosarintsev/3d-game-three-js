{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Level brief v4 (kind: cityforge, schemaVersion: 4)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this brief schema: ./level-v4.schema.json."
    },
    "kind": {
      "type": "string",
      "enum": [
        "cityforge"
      ],
      "description": "CityForge v4 source brief with district generator manifest."
    },
    "schemaVersion": {
      "type": "number",
      "description": "Format version: v4 (district-aware generator)."
    },
    "metadata": {
      "$ref": "./level-common.schema.json#/definitions/metadata"
    },
    "ground": {
      "$ref": "./level-common.schema.json#/definitions/ground"
    },
    "gameplay": {
      "$ref": "./level-common.schema.json#/definitions/gameplay"
    },
    "stream": {
      "$ref": "./level-common.schema.json#/definitions/stream"
    },
    "windows": {
      "type": "object",
      "properties": {
        "spacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 12,
          "description": "м: ритм окон вдоль грани",
          "default": 3
        },
        "width": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 6,
          "description": "м: ширина квада",
          "default": 1.15
        },
        "height": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 6,
          "description": "м: высота квада",
          "default": 1.6
        },
        "sill": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "м: подоконник от пола этажа",
          "default": 0.9
        },
        "offset": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1,
          "description": "м: вынос квада за грань стены",
          "default": 0.06
        },
        "lit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "доля окон светящимися",
          "default": 0.4
        }
      },
      "additionalProperties": false,
      "description": "включатель + переопределение ряда окон"
    },
    "sky": {
      "type": "object",
      "properties": {
        "sky": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ],
          "description": "цвет неба",
          "default": 11130101
        },
        "fog": {
          "type": "object",
          "properties": {
            "color": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              ],
              "description": "цвет тумана",
              "default": 14084607
            },
            "near": {
              "type": "number",
              "minimum": 1,
              "description": "м: начало тумана",
              "default": 120
            },
            "far": {
              "type": "number",
              "minimum": 2,
              "description": "м: полное затемнение",
              "default": 460
            }
          },
          "additionalProperties": false,
          "description": "туман"
        },
        "sun": {
          "type": "object",
          "properties": {
            "color": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              ],
              "description": "цвет солнца/луны",
              "default": 16774368
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "яркость",
              "default": 2.4
            },
            "position": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "[x,y,z]",
              "default": [
                150,
                200,
                -110
              ]
            }
          },
          "additionalProperties": false,
          "description": "направленный свет"
        },
        "hemi": {
          "type": "object",
          "properties": {
            "sky": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              ],
              "description": "верх полусферического света",
              "default": 12575743
            },
            "ground": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              ],
              "description": "низ полусферического света",
              "default": 4877107
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "яркость",
              "default": 1
            }
          },
          "additionalProperties": false,
          "description": "полусферический свет"
        },
        "lights": {
          "type": "object",
          "properties": {
            "count": {
              "type": "number",
              "minimum": 0,
              "maximum": 8,
              "description": "штук: огней пула",
              "default": 6
            },
            "reach": {
              "type": "number",
              "minimum": 1,
              "description": "м: радиус поиска опор",
              "default": 60
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "description": "м: подъём огня",
              "default": 6
            },
            "spacing": {
              "type": "number",
              "minimum": 1,
              "description": "м: разнос огней",
              "default": 26
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "яркость огня",
              "default": 60
            }
          },
          "additionalProperties": false,
          "description": "пул ночных огней"
        }
      },
      "additionalProperties": false,
      "description": "небо/освещение главы"
    },
    "properties": {
      "type": "object",
      "properties": {}
    },
    "navEdgeProbe": {
      "type": "number",
      "minimum": 0.1,
      "description": "Шаг проб опоры вдоль навигационных рёбер (м). Меньше — точнее, больше — быстрее сборка."
    },
    "bodyProbe": {
      "type": "number",
      "minimum": 0.1,
      "description": "Шаг проб габарита тела вдоль навигационных рёбер (м). Меньше — точнее, больше — быстрее сборка."
    },
    "buildings": {
      "type": "array",
