            "type": "number",
            "minimum": 0.5,
            "maximum": 2,
            "description": "масштаб окон"
          },
          "roofMaterial": {
            "type": "string",
            "description": "материал кровли"
          },
          "roofColor": {
            "type": "string",
            "description": "цвет кровли"
          },
          "trimFinish": {
            "type": "string",
            "description": "отделка"
          },
          "houseFeatures": {
            "type": "object",
            "properties": {},
            "additionalProperties": false,
            "description": "фичи дома"
          },
          "roof": {
            "type": "object",
            "properties": {
              "walkable": {
                "type": "boolean",
                "description": "ходовая ли кровля",
                "default": false
              },
              "parapet": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.5,
                "description": "м: парапет",
                "default": 0.9
              }
            },
            "additionalProperties": false,
            "description": "кровля"
          },
          "footprint": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "description": "м: мировая координата X"
                },
                "z": {
                  "type": "number",
                  "description": "м: мировая координата Z"
                }
              },
              "required": [
                "x",
                "z"
              ],
              "additionalProperties": false,
              "description": "точка в плане (метры)"
            },
            "description": "м: полигон плана дома"
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "id комнаты"
                },
                "floor": {
                  "type": "number",
                  "minimum": 0,
                  "description": "этаж"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "office",
                    "corridor",
                    "hall",
                    "room",
                    "cafe",
                    "utility",
                    "lobby",
                    "market",
                    "warehouse"
